AI_GATEWAY_API_KEY=your_ai_gateway_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# CoinPulse backend URL (e.g. https://your-coinpulse-backend.vercel.app)
# When set, /api/portfolio/dashboard proxies to the backend instead of using local RPC.
# Required for /api/wallets, /api/sync, /api/rebuild, and /api/debug/health.
COINPULSE_BACKEND_URL=
